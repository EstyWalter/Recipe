<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RecipeAppsMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RecipeAppsMAUI"
    Title="RecipeAppsMAUI">

    <TabBar>

        <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:Home}"
        Route="Home" />

        <ShellContent
        Title="Search Recipe"
        ContentTemplate="{DataTemplate local:SearchRecipe}"
        Route="Search Recipe" />
    </TabBar>
    
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:Login}"
        Route="Login" />

</Shell>
