<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeAppsMAUI.SearchRecipe"
             Title="SearchRecipe">
    <VerticalStackLayout>
        <Button x:Name="SearchRecipebtn" Text="Search Recipe" Clicked="SearchRecipebtn_Clicked" HorizontalOptions="Center"/>
        <CollectionView x:Name="RecipeLst" HorizontalOptions="Center">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding [recipename]}" HorizontalOptions="Start"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>